# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Evaluation outputs. Commit a run deliberately (git add -f) when it backs a
# result recorded in docs/EXPERIMENTS.md; do not let every scratch run land.
results/eval/

# Hard-set audio. Keep clips out of git unless they are small and
# redistributable — see data/hard_set/README.md.
data/hard_set/audio/*
!data/hard_set/audio/.gitkeep

# OS
.DS_Store

# Trainer resume state. A checkpoint's adapter weights + config are evidence;
# optimizer/scheduler/RNG state is not, and it is ~40 MB per checkpoint.
optimizer.pt
scheduler.pt
rng_state.pth
scaler.pt
trainer_state.json
results/whisper-lora-*/checkpoint-*/
results/streaming/*
!results/streaming/*.json
results/gpu_validation/*
!results/gpu_validation/*.json
!results/gpu_validation/*.md
results/streaming_eval/**/*.wav
results/streaming_eval/**/*.mp3
results/llm_bakeoff/**/*.bin
